                  <a href="https://www.powerschool.com/privacy/" target="_blank" style="color: #0066a5 !important;" ng-if="!isi18nEnabledGuardian">
                    Privacy
                  </a>
                  <a href="https://www.powerschool.com/privacy/" target="_blank" style="color: #0066a5 !important;" ng-if="isi18nEnabledGuardian">
                    {{commonMessageKeys['eec.html.public_formbuilder.form.privacy']}}
                  </a>
                  •
