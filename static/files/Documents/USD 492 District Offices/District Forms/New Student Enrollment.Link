                    Terms
                  </a>
                  <a href="https://www.powerschool.com/terms/" target="_blank" style="color: #0066a5 !important;" ng-if="isi18nEnabledGuardian">
                    {{commonMessageKeys['eec.html.public_formbuilder.form.terms']}}
                  </a>
                  </span>
                </p>
              </div>
            </div>
          </main>
        </div>
